{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "mz296",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "8926b0b2-188d-40cb-bd0d-b26f800e2ea9","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "9b72cf24e4ea4cd5b60ef9096528a8c5" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
